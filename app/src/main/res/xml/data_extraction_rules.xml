<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. allowBackup is false; these rules additionally keep the financial
    database and settings out of cloud backup and device transfer. The in-app JSON
    export is the backup path (project-schema → Decisions).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
