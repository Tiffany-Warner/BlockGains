<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower. allowBackup is false; these rules additionally keep the
    financial database and settings (DataStore lives under files/) out of backups.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
